maintainer="Redmi9T bring-up project"
pkgname=linux-xiaomi-lemon
pkgver=7.4_rc1
pkgrel=0
pkgdesc="Pinned mainline SM6115/lemon kernel for the external ARM64 bootshim"
url="https://kernel.org"
license="GPL-2.0-only"
arch="aarch64"
options="!strip !check !tracedeps"
makedepends="bash bc bison flex perl openssl-dev elfutils-dev python3 dtc"
_commit=05441d697f7f9a927264f4058cbbc6a03dfcac9d
source="linux-$_commit.tar.gz::https://github.com/torvalds/linux/archive/$_commit.tar.gz
    config-xiaomi-lemon.aarch64
    lemon-runtime.dts
"
builddir="$srcdir/linux-$_commit"

prepare() {
    default_prepare
    cp "$srcdir/config-xiaomi-lemon.aarch64" .config
    make ARCH=arm64 olddefconfig
}

build() {
    make ARCH=arm64 Image.gz
    dtc -I dts -O dtb -o lemon-runtime.dtb "$srcdir/lemon-runtime.dts"
}

package() {
    install -Dm644 arch/arm64/boot/Image.gz "$pkgdir/boot/vmlinuz-xiaomi-lemon"
    install -Dm644 lemon-runtime.dtb "$pkgdir/boot/dtbs/qcom/sm6115-xiaomi-lemon.dtb"
    install -Dm644 .config "$pkgdir/boot/config-xiaomi-lemon"
}

