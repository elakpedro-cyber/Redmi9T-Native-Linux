#!/rescue/busybox sh
export PATH=/rescue:/sbin:/bin:/usr/sbin:/usr/bin
mount -t devtmpfs devtmpfs /dev
echo 'LEMON_INIT_V5_REACHED: native Linux /init executing' > /dev/kmsg
mkdir -p /dev/pts /proc /sys /run /tmp
mount -t proc proc /proc
mount -t sysfs sysfs /sys
cat /sys/firmware/devicetree/base/chosen/xiaomi,bootshim-info > /dev/kmsg
mount -t tmpfs tmpfs /run
echo 'LEMON_INIT_V5_REACHED' > /run/init-reached
mount -t tmpfs tmpfs /tmp
mount -t devpts devpts /dev/pts
{
    for d in /sys/block/sd*; do
        echo "$d"
        cat "$d/stat" "$d/device/ioerr_cnt"
    done
    cat /proc/mounts /proc/swaps
} > /run/ufs-stat-initial.txt
echo "Redmi9T Native Linux: initramfs reached"
uname -a
mount -t configfs configfs /sys/kernel/config
mkdir -p /sys/fs/pstore
mount -t pstore pstore /sys/fs/pstore
(
    g=/sys/kernel/config/usb_gadget/lemon
    mkdir -p "$g"
    cd "$g" || exit
    echo 0x1d6b > idVendor
    echo 0x0104 > idProduct
    mkdir -p strings/0x409 configs/c.1/strings/0x409 functions/acm.usb0
    echo lemon-bringup > strings/0x409/serialnumber
    echo Linux > strings/0x409/manufacturer
    echo 'Redmi9T bring-up serial' > strings/0x409/product
    echo 'ACM console' > configs/c.1/strings/0x409/configuration
    echo 250 > configs/c.1/MaxPower
    ln -s functions/acm.usb0 configs/c.1/acm.usb0
    # Optional composite mode is selected before binding; default remains ACM-only.
    usbnet=$(cat /etc/lemon/usbnet-mode 2>/dev/null)
    for arg in $(cat /proc/cmdline); do
        case "$arg" in lemon.usbnet=*) usbnet=${arg#lemon.usbnet=} ;; esac
    done
    case "$usbnet" in
        ecm|ncm|rndis)
            if mkdir -p "functions/$usbnet.usb0"; then
                echo 0x0105 > idProduct
                echo 0xef > bDeviceClass
                echo 0x02 > bDeviceSubClass
                echo 0x01 > bDeviceProtocol
                echo 02:00:00:00:77:02 > "functions/$usbnet.usb0/dev_addr"
                echo 02:00:00:00:77:01 > "functions/$usbnet.usb0/host_addr"
                ln -s "functions/$usbnet.usb0" "configs/c.1/$usbnet.usb0"
            else
                echo "Optional USB $usbnet unavailable; retaining ACM" > /dev/kmsg
                usbnet=
            fi
            ;;
        *) usbnet= ;;
    esac
    n=0
    while [ "$n" -lt 60 ]; do
        udc=$(ls /sys/class/udc 2>/dev/null | head -n 1)
        [ -n "$udc" ] && break
        sleep 1
        n=$((n + 1))
    done
    if [ -z "$udc" ]; then
        echo 'No USB device controller found' > /dev/kmsg
        exit
    fi
    echo "$udc" > UDC || exit
    echo "USB ACM bound to $udc; host enumeration unverified" > /dev/kmsg
    if [ -n "$usbnet" ]; then
        /sbin/ip address add 192.168.77.2/30 dev usb0
        /sbin/ip link set usb0 up
    fi
    dmesg > /run/boot-dmesg.txt
    while :; do
        /rescue/getty -L -n -l /usr/local/sbin/lemon-root-shell 115200 ttyGS0 vt100
        sleep 1
    done
) >/run/usb-setup.log 2>&1 &


export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
echo 'Starting Alpine BusyBox init and OpenRC in RAM'
exec /sbin/init
