--- v2.1/session.sh
+++ touchscreen-v1/session-touch.sh
@@ -100,6 +100,13 @@
             chmod 755 "$g/usr/libexec/mutter-devkit"
         fi
     fi
+    if [ -n "${LEMON_TOUCH_EVENT:-}" ]; then
+        cp "$base/wlfreerdp3-touch" "$w/usr/bin/wlfreerdp3.touch"
